# ==========================================
# ⚙️ CONFIGURACIÓN GENERAL DEL PROYECTO
# ==========================================
PROJECT_NAME=Sistema de Predicción de Desnutrición Infantil
PROJECT_VERSION=0.1.0
API_VERSION=v1

# ==========================================
# 🔐 SEGURIDAD / JWT
# ==========================================
# Usa una clave secreta larga y aleatoria (puedes generarla con: openssl rand -hex 32)
SECRET_KEY=supersecreto_cambia_esto_123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 días

# ==========================================
# 🗄️ BASE DE DATOS
# ==========================================
# Formato: postgresql+psycopg2://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg2://postgres:admin123@localhost:5432/desnutricion_db

# ==========================================
# 🤖 MACHINE LEARNING
# ==========================================
# Ruta donde están guardados los modelos entrenados (.pkl)
ML_MODELS_PATH=app/infrastructure/ml/models

# ==========================================
# 🌐 VARIABLES ADICIONALES (opcional)
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=info
